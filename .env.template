# AI Employee Vault — Environment Variables Template
#
# Copy this file to .env and fill in real values.
# NEVER commit .env to git. It is gitignored.
#
# Usage:
#   cp .env.template .env
#   # Edit .env with real values
#   source .env  (Linux/Mac)
#   # or use python-dotenv in scripts

# ── Vault ─────────────────────────────────────────────────────────────────────
VAULT_ROOT=/absolute/path/to/AI_Employee_Vault

# ── Safety flags ──────────────────────────────────────────────────────────────
# Set DRY_RUN=true to prevent all writes (read-only preview mode)
DRY_RUN=false
# Set DEV_MODE=true to use fixture data instead of live APIs
DEV_MODE=false

# ── Odoo ──────────────────────────────────────────────────────────────────────
ODOO_URL=http://127.0.0.1:8069
ODOO_DB=odoo_vault
ODOO_USERNAME=your_odoo_user
ODOO_PASSWORD=REPLACE_ME

# ── Gmail ─────────────────────────────────────────────────────────────────────
# Path to OAuth2 client credentials JSON downloaded from Google Cloud Console
# NEVER store this file inside the vault
GMAIL_CREDENTIALS=/path/outside/vault/gmail_credentials.json
GMAIL_TOKEN_PATH=/path/outside/vault/gmail_token.json
GMAIL_POLL_INTERVAL=120

# ── WhatsApp (Playwright) ─────────────────────────────────────────────────────
# Persistent browser session directory — outside vault
WHATSAPP_SESSION_DIR=/path/outside/vault/whatsapp_session
WA_POLL_INTERVAL=60

# ── Finance watcher ───────────────────────────────────────────────────────────
FINANCE_POLL_INTERVAL=3600

# ── Orchestrator ──────────────────────────────────────────────────────────────
AGENT_ID=orchestrator-local
ORCH_POLL_INTERVAL=30
ORCH_MAX_CLAIM_AGE=30
# Path to claude CLI binary
CLAUDE_CLI=claude

# ── Email MCP ─────────────────────────────────────────────────────────────────
# (Configure in .mcp.json — never here)

# ── Rate limits (override defaults) ──────────────────────────────────────────
MAX_EMAILS_PER_DAY=50
MAX_INVOICES_PER_DAY=20
MAX_PAYMENTS_PER_DAY=10
